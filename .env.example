# Copiar a ".env" (en la misma carpeta que docker-compose.yml) y completar.
# El archivo ".env" NO se sube a git. No pongas aquí datos reales de clientes.

# --- Base de datos (MySQL dentro de Docker) ---
DB_NAME=facturas
DB_USER=facto
DB_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-otra-clave

# --- Sesión (JWT) ---
# Generar una clave larga: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256

# --- IA (Gemini) ---
API_KEY=
